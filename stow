#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${STOW_FOLDERS:-}" ]]; then
  STOW_FOLDERS="claude,git,karabiner,nvim,raycast,skhd,tmux,wezterm,yabai,yazi,zsh"
fi

if [[ -z "${DOTFILES:-}" ]]; then
  DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

pushd "$DOTFILES" > /dev/null

for folder in $(echo "$STOW_FOLDERS" | sed 's/,/ /g'); do
  echo "stow $folder"
  stow -D "$folder" 2>/dev/null || true
  stow "$folder"
done

# Firefox profile dirs have random names, so stow can't target them; link user.js into each
for profile in "$HOME/Library/Application Support/Firefox/Profiles"/*/; do
  if [[ -d "$profile" ]]; then ln -sf "$DOTFILES/firefox/user.js" "${profile}user.js"; fi
done

popd > /dev/null
